NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv:/

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Optional – only for justified, authorised profile images (not used by default)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# One-time provisioning of the first Super Admin (npm run create-superadmin)
SUPERADMIN_FULLNAME=
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
